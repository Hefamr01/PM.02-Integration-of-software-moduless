<!--  Views/Pages/ProductionOrdersPage.xaml  -->
<Page
    x:Class="TechModule.Views.Pages.ProductionOrdersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Производственные заказы">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DataGrid
            AutoGenerateColumns="True"
            IsReadOnly="True"
            ItemsSource="{Binding Orders}"
            SelectedItem="{Binding SelectedOrder}" />
        <StackPanel
            Grid.Row="1"
            Margin="0,10,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="80"
                Margin="5"
                Command="{Binding AddCommand}"
                Content="Добавить" />
            <Button
                Width="80"
                Margin="5"
                Command="{Binding EditCommand}"
                Content="Изменить" />
            <Button
                Width="80"
                Margin="5"
                Command="{Binding DeleteCommand}"
                Content="Удалить" />
            <ComboBox
                x:Name="StatusCombo"
                Width="120"
                Margin="5"
                SelectedIndex="0">
                <ComboBoxItem Content="planned" />
                <ComboBoxItem Content="in_progress" />
                <ComboBoxItem Content="completed" />
                <ComboBoxItem Content="cancelled" />
            </ComboBox>
            <Button
                Width="120"
                Margin="5"
                Command="{Binding SetStatusCommand}"
                CommandParameter="{Binding SelectedItem.Content, ElementName=StatusCombo}"
                Content="Сменить статус" />
        </StackPanel>
    </Grid>
</Page>