<Page
    x:Class="TechModule.Views.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Главная">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            Margin="0,0,0,10"
            FontSize="20"
            FontWeight="Bold"
            Text="Сводка по производству" />
        <WrapPanel Grid.Row="1">
            <Border
                Width="200"
                Margin="5"
                Padding="10"
                BorderBrush="Gray"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock FontWeight="Bold" Text="Активные продукты" />
                    <TextBlock FontSize="24" Text="{Binding Data.active_products}" />
                </StackPanel>
            </Border>
            <Border
                Width="200"
                Margin="5"
                Padding="10"
                BorderBrush="Gray"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock FontWeight="Bold" Text="Активные рецепты" />
                    <TextBlock FontSize="24" Text="{Binding Data.active_recipes}" />
                </StackPanel>
            </Border>
            <Border
                Width="200"
                Margin="5"
                Padding="10"
                BorderBrush="Gray"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock FontWeight="Bold" Text="Активные тех. карты" />
                    <TextBlock FontSize="24" Text="{Binding Data.active_tech_maps}" />
                </StackPanel>
            </Border>
            <Border
                Width="200"
                Margin="5"
                Padding="10"
                BorderBrush="Gray"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock FontWeight="Bold" Text="Заказы в работе" />
                    <TextBlock FontSize="24" Text="{Binding Data.orders_in_work}" />
                </StackPanel>
            </Border>
            <Border
                Width="200"
                Margin="5"
                Padding="10"
                BorderBrush="Gray"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock FontWeight="Bold" Text="Партии в производстве" />
                    <TextBlock FontSize="24" Text="{Binding Data.batches_in_production}" />
                </StackPanel>
            </Border>
            <Border
                Width="200"
                Margin="5"
                Padding="10"
                BorderBrush="Gray"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock FontWeight="Bold" Text="Отклонения" />
                    <TextBlock FontSize="24" Text="{Binding Data.batches_with_deviations}" />
                </StackPanel>
            </Border>
        </WrapPanel>
        <ListBox
            Grid.Row="2"
            Height="200"
            Margin="10"
            ItemsSource="{Binding Data.latest_events_json}" />
    </Grid>
</Page>