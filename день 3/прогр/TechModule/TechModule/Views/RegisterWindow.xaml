<Window
    x:Class="TechModule.Views.RegisterWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Регистрация"
    Width="400"
    Height="500">
    <Grid Margin="10">
        <StackPanel>
            <TextBlock Text="Логин" />
            <TextBox Text="{Binding Username}" />
            <TextBlock Text="Пароль" />
            <PasswordBox x:Name="PasswordBox" />
            <TextBlock Text="Полное имя" />
            <TextBox Text="{Binding FullName}" />
            <TextBlock Text="Email" />
            <TextBox Text="{Binding Email}" />
            <TextBlock Text="Телефон" />
            <TextBox Text="{Binding Phone}" />
            <TextBlock Text="Роль (1-админ, 2-технолог, 3-лаборант)" />
            <TextBox Text="{Binding RoleId}" />
            <TextBlock Text="ID отдела (необязательно)" />
            <TextBox Text="{Binding DepartmentId}" />
            <TextBlock Foreground="Red" Text="{Binding Error}" />
            <TextBlock Foreground="Green" Text="{Binding Message}" />

            <TextBlock Margin="0,5,0,0" Text="Введите код:" />
            <StackPanel Margin="0,5" Orientation="Horizontal">
                <Image
                    Width="120"
                    Height="40"
                    Margin="0,0,10,0"
                    Source="{Binding CaptchaImage}"
                    Stretch="Uniform" />
                <Button
                    Width="40"
                    VerticalAlignment="Center"
                    Command="{Binding RefreshCaptchaCommand}"
                    Content="🔄" />
            </StackPanel>
            <TextBox Margin="0,0,0,10" Text="{Binding UserCaptchaInput, UpdateSourceTrigger=PropertyChanged}" />

            <Button
                Margin="0,10"
                Command="{Binding RegisterCommand}"
                Content="Зарегистрироваться" />
        </StackPanel>
    </Grid>
</Window>