<Window
    x:Class="TechModule.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Модуль технолога"
    Width="1000"
    Height="700">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Боковое меню  -->
        <StackPanel Grid.Column="0" Background="#f0f0f0">
            <Button
                Command="{Binding NavigateCommand}"
                CommandParameter="Dashboard"
                Content="Главная" />
            <Button
                Command="{Binding NavigateCommand}"
                CommandParameter="Products"
                Content="Продукция" />
            <Button
                Command="{Binding NavigateCommand}"
                CommandParameter="Recipes"
                Content="Рецептуры" />
            <Button
                Command="{Binding NavigateCommand}"
                CommandParameter="TechMaps"
                Content="Тех. карты" />
            <Button
                Command="{Binding NavigateCommand}"
                CommandParameter="Orders"
                Content="Производственные заказы" />
            <Button
                Command="{Binding NavigateCommand}"
                CommandParameter="Batches"
                Content="Партии" />
        </StackPanel>

        <!--  Область контента  -->
        <Frame
            x:Name="MainFrame"
            Grid.Column="1"
            NavigationUIVisibility="Hidden" />
    </Grid>
</Window>