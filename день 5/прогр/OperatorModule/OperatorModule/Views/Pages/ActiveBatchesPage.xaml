<Page x:Class="OperatorModule.Views.Pages.ActiveBatchesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Активные партии">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DataGrid AutoGenerateColumns="True" IsReadOnly="True"
                  ItemsSource="{Binding Batches}" SelectedItem="{Binding SelectedBatch}" />
        <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Width="140" Margin="5" Command="{Binding StartBatchCommand}" Content="Запустить партию" />
            <Button Width="140" Margin="5" Command="{Binding ExecuteBatchCommand}" Content="Выполнить партию" />
            <Button Width="120" Margin="5" Click="Refresh_Click" Content="Обновить" />
        </StackPanel>
    </Grid>
</Page>