<Window
    x:Class="OperatorModule.Views.RegisterWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Регистрация"
    Width="450"
    Height="650"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <StackPanel>
            <TextBlock Text="Логин *" />
            <TextBox MaxLength="50" Text="{Binding Username}" />
            <TextBlock Text="Пароль *" />
            <PasswordBox x:Name="PasswordBox" MaxLength="50" />
            <TextBlock Text="Полное имя *" />
            <TextBox MaxLength="50" Text="{Binding FullName}" />
            <TextBlock Text="Email (необязательно)" />
            <TextBox MaxLength="50" Text="{Binding Email}" />
            <TextBlock Margin="0,10,0,0" Text="Телефон (необязательно)" />
            <TextBox
                MaxLength="20"
                Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="Формат: +7XXXXXXXXXX или 8XXXXXXXXXX (11 цифр)" />
            <!--  ComboBox для роли  -->
            <TextBlock Margin="0,10,0,0" Text="Роль *" />
            <ComboBox
                DisplayMemberPath="name"
                ItemsSource="{Binding Roles}"
                SelectedItem="{Binding SelectedRole}"
                SelectedValuePath="id" />

            <!--  ComboBox для отдела (необязательно)  -->
            <TextBlock Margin="0,10,0,0" Text="Отдел (необязательно)" />
            <ComboBox
                DisplayMemberPath="name"
                ItemsSource="{Binding Departments}"
                SelectedItem="{Binding SelectedDepartment}"
                SelectedValuePath="id" />

            <Border
                Margin="0,10"
                Padding="5"
                Background="#FFE6E6"
                BorderBrush="Red"
                BorderThickness="1"
                Visibility="{Binding Error, Converter={StaticResource StringToVisibility}}">
                <TextBlock
                    Foreground="Red"
                    Text="{Binding Error}"
                    TextWrapping="Wrap" />
            </Border>

            <Border
                Margin="0,5"
                Padding="5"
                Background="#E6FFE6"
                BorderBrush="Green"
                BorderThickness="1"
                Visibility="{Binding Message, Converter={StaticResource StringToVisibility}}">
                <TextBlock
                    Foreground="Green"
                    Text="{Binding Message}"
                    TextWrapping="Wrap" />
            </Border>

            <TextBlock Margin="0,5,0,0" Text="Введите код:" />
            <StackPanel Margin="0,5" Orientation="Horizontal">
                <Image
                    Width="120"
                    Height="40"
                    Margin="0,0,10,0"
                    Source="{Binding CaptchaImage}"
                    Stretch="Uniform" />
                <Button
                    Width="40"
                    VerticalAlignment="Center"
                    Command="{Binding RefreshCaptchaCommand}"
                    Content="🔄" />
            </StackPanel>
            <TextBox
                Margin="0,0,0,10"
                MaxLength="50"
                Text="{Binding UserCaptchaInput, UpdateSourceTrigger=PropertyChanged}" />

            <Button
                Margin="0,10"
                Command="{Binding RegisterCommand}"
                Content="Зарегистрироваться" />
        </StackPanel>
    </Grid>
</Window>