<Window x:Class="LabModule.Views.Pages.ProtocolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Протокол контроля качества" Width="700" Height="600" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <TextBlock Text="{Binding ProtocolText}" TextWrapping="Wrap" FontFamily="Consolas" />
        </ScrollViewer>
        <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Width="120" Margin="5" Command="{Binding SaveCommand}" Content="Сохранить в файл" />
            <Button Width="100" Margin="5" Click="Close_Click" Content="Закрыть" />
        </StackPanel>
    </Grid>
</Window>