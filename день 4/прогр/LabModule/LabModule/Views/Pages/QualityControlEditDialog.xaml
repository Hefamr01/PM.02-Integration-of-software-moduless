<Window x:Class="LabModule.Views.Pages.QualityControlEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Контроль качества" Width="450" Height="450" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Параметр:" Margin="0,5"/>
        <TextBox Grid.Row="1" Text="{Binding Control.parameter_name}" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="2" Text="Норматив (например '10;20' или '>=5'):" Margin="0,5"/>
        <TextBox Grid.Row="3" Text="{Binding Control.standard_value}" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="4" Text="Измеренное значение:" Margin="0,5"/>
        <TextBox Grid.Row="5" Text="{Binding Control.measured_value}" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="6" Text="Единица измерения:" Margin="0,5"/>
        <TextBox Grid.Row="7" Text="{Binding Control.unit}" Margin="0,0,0,10"/>
        <StackPanel Grid.Row="8" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Width="100" Margin="5" Command="{Binding SaveCommand}" Content="Сохранить"/>
            <Button Width="100" Margin="5" Click="Cancel_Click" Content="Отмена"/>
        </StackPanel>
        <TextBlock Grid.Row="8" Margin="5" VerticalAlignment="Center" Foreground="Red" Text="{Binding Error}"/>
    </Grid>
</Window>