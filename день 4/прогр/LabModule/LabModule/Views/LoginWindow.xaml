<Window
    x:Class="LabModule.Views.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Вход - Лаборатория"
    Width="400"
    Height="430">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Логин" />
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Margin="0,10,0,0" Text="Пароль" />
            <PasswordBox x:Name="PasswordBox" />

            <!--  Сообщение об ошибке  -->
            <Border
                Margin="0,10"
                Padding="5"
                Background="#FFE6E6"
                BorderBrush="Red"
                BorderThickness="1"
                Visibility="{Binding Error, Converter={StaticResource StringToVisibility}}">
                <TextBlock
                    Foreground="Red"
                    Text="{Binding Error}"
                    TextWrapping="Wrap" />
            </Border>

            <TextBlock Margin="0,5,0,0" Text="Введите код:" />
            <StackPanel Margin="0,5" Orientation="Horizontal">
                <Image
                    Width="120"
                    Height="40"
                    Margin="0,0,10,0"
                    Source="{Binding CaptchaImage}"
                    Stretch="Uniform" />
                <Button
                    Width="40"
                    VerticalAlignment="Center"
                    Command="{Binding RefreshCaptchaCommand}"
                    Content="🔄" />
            </StackPanel>
            <TextBox Margin="0,0,0,10" Text="{Binding UserCaptchaInput, UpdateSourceTrigger=PropertyChanged}" />

            <Button
                Height="30"
                Margin="0,10"
                Command="{Binding LoginCommand}"
                CommandParameter="{Binding ElementName=PasswordBox}"
                Content="Войти" />
            <Button Click="RegisterButton_Click" Content="Регистрация" />
        </StackPanel>
    </Grid>
</Window>