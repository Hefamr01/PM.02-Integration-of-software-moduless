<Window
    x:Class="LabModule.Views.RegisterWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Регистрация"
    Width="450"
    Height="650"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <StackPanel>
            <TextBlock Text="Логин *" />
            <TextBox Text="{Binding Username}" />
            <TextBlock Text="Пароль *" />
            <PasswordBox x:Name="PasswordBox" />
            <TextBlock Text="Полное имя *" />
            <TextBox Text="{Binding FullName}" />
            <TextBlock Text="Email (необязательно)" />
            <TextBox Text="{Binding Email}" />
            <TextBlock Text="Телефон (необязательно)" />
            <TextBox Text="{Binding Phone}" />
            <TextBlock Text="Роль (1-админ, 2-технолог, 3-лаборант) *" />
            <TextBox Text="{Binding RoleId}" />
            <TextBlock Text="ID отдела (необязательно)" />
            <TextBox Text="{Binding DepartmentId}" />

            <!--  Сообщение об ошибке  -->
            <Border
                Margin="0,10"
                Padding="5"
                Background="#FFE6E6"
                BorderBrush="Red"
                BorderThickness="1"
                Visibility="{Binding Error, Converter={StaticResource StringToVisibility}}">
                <TextBlock
                    Foreground="Red"
                    Text="{Binding Error}"
                    TextWrapping="Wrap" />
            </Border>

            <!--  Сообщение об успехе  -->
            <Border
                Margin="0,5"
                Padding="5"
                Background="#E6FFE6"
                BorderBrush="Green"
                BorderThickness="1"
                Visibility="{Binding Message, Converter={StaticResource StringToVisibility}}">
                <TextBlock
                    Foreground="Green"
                    Text="{Binding Message}"
                    TextWrapping="Wrap" />
            </Border>

            <TextBlock Margin="0,5,0,0" Text="Введите код:" />
            <StackPanel Margin="0,5" Orientation="Horizontal">
                <Image
                    Width="120"
                    Height="40"
                    Margin="0,0,10,0"
                    Source="{Binding CaptchaImage}"
                    Stretch="Uniform" />
                <Button
                    Width="40"
                    VerticalAlignment="Center"
                    Command="{Binding RefreshCaptchaCommand}"
                    Content="🔄" />
            </StackPanel>
            <TextBox Margin="0,0,0,10" Text="{Binding UserCaptchaInput, UpdateSourceTrigger=PropertyChanged}" />

            <Button
                Margin="0,10"
                Command="{Binding RegisterCommand}"
                Content="Зарегистрироваться" />
        </StackPanel>
    </Grid>
</Window>